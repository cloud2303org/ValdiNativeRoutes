+        "//bzl/valdi:js_bytecode_format_hermes",
     ],
 )
 
@@ -107,6 +109,34 @@
 )
 
 custom_selects.config_setting_inverse(
+    "not_js_bytecode_format_hermes",
+    inverse_of = "//bzl/valdi:js_bytecode_format_hermes",
+)
+
+# Modules precompiled to Hermes bytecode only ever run on Hermes, so QuickJS and JavaScriptCore would be dead weight.
+selects.config_setting_group(
+    name = "quickjs_runtime_enabled",
+    match_all = [
+        ":quickjs_enabled",
+        ":not_js_bytecode_format_hermes",
+    ],
+)
+
+selects.config_setting_group(
+    name = "jscore_runtime_enabled",
+    match_all = [
+        ":jscore_enabled",
+        ":not_js_bytecode_format_hermes",
+    ],
+)
+
+# Only the JavaScriptCore engine (valdi_jscore) uses the framework.
+JSCORE_FRAMEWORKS = select({
+    ":jscore_runtime_enabled": ["JavaScriptCore"],
+    "//conditions:default": [],
+})
+
+custom_selects.config_setting_inverse(
     "libcxx_rtti_enabled",
     inverse_of = "@snap_client_toolchains//:sc_build_flag_libcxx_rtti_disabled",
 )
