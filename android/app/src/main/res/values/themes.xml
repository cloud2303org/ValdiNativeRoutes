<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The starting window has the page's color, so nothing flashes white before the first page draws. -->
    <style name="Theme.ValdiNativeRoutes" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_background</item>
    </style>
    <style name="Theme.ValdiNativeRoutes.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/page_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/valdi_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.ValdiNativeRoutes</item>
    </style>
</resources>
