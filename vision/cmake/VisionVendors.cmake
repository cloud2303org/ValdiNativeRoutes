# Optional CMake consumers. Bazel runtime consumers use @vision//:vision_core.
# Static Android is the default; standalone shared consumers opt in explicitly.
if(NOT VISION_VENDOR_TARGET)
  message(FATAL_ERROR "Set VISION_VENDOR_TARGET to the prepared target")
endif()
get_filename_component(VISION_PACKAGE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(VISION_VENDOR_PREFIX "${VISION_PACKAGE_ROOT}/vendor/install/${VISION_VENDOR_TARGET}")
if(ANDROID)
  if(NOT DEFINED VISION_VENDOR_LINKAGE)
    set(VISION_VENDOR_LINKAGE static)
  endif()
  if(NOT VISION_VENDOR_LINKAGE MATCHES "^(static|shared)$")
    message(FATAL_ERROR "VISION_VENDOR_LINKAGE must be static or shared")
  endif()
  if(NOT VISION_VENDOR_TARGET STREQUAL "android-arm64")
    message(FATAL_ERROR "Vision's Android vendors support android-arm64 only")
  endif()
  string(APPEND VISION_VENDOR_PREFIX "/${VISION_VENDOR_LINKAGE}")
endif()
if(NOT EXISTS "${VISION_VENDOR_PREFIX}/native-routes-vision.json")
  message(FATAL_ERROR "Run node vision/scripts/prepare-native.cjs --target ${VISION_VENDOR_TARGET} first")
endif()
if(ANDROID)
  file(READ "${VISION_VENDOR_PREFIX}/native-routes-vision.json" VISION_VENDOR_RECEIPT)
  file(READ "${VISION_PACKAGE_ROOT}/vendor-lock.json" VISION_VENDOR_LOCK)
  function(vision_require_receipt expected)
    string(JSON actual ERROR_VARIABLE error GET "${VISION_VENDOR_RECEIPT}" ${ARGN})
    if(error OR NOT "${actual}" STREQUAL "${expected}")
      message(FATAL_ERROR "Android Vision receipt mismatch (${ARGN}); re-run node vision/scripts/prepare-native.cjs --target android-arm64 with the app's NDK")
    endif()
  endfunction()
  vision_require_receipt("android-arm64" target)
  vision_require_receipt("${VISION_VENDOR_LINKAGE}" linkage)
  vision_require_receipt("ON" cpuOnly)
  foreach(VISION_DEPENDENCY opencv ncnn)
    string(JSON VISION_VERSION GET "${VISION_VENDOR_LOCK}" ${VISION_DEPENDENCY} version)
    string(JSON VISION_PIN GET "${VISION_VENDOR_LOCK}" ${VISION_DEPENDENCY} sha256)
    vision_require_receipt("${VISION_VERSION}" ${VISION_DEPENDENCY})
    vision_require_receipt("${VISION_PIN}" sourcePins ${VISION_DEPENDENCY})
  endforeach()
  # NDK's legacy toolchain sets CMAKE_SYSTEM_VERSION=1, even for API 28.
  # Its resolved native API is the level used in Clang's target triple.
  if(DEFINED ANDROID_NATIVE_API_LEVEL)
    set(VISION_ANDROID_API "${ANDROID_NATIVE_API_LEVEL}")
  else()
    set(VISION_ANDROID_API "${CMAKE_SYSTEM_VERSION}")
  endif()
  if(VISION_VENDOR_LINKAGE STREQUAL "static")
    file(READ "${VISION_PACKAGE_ROOT}/android-runtime.json" VISION_RUNTIME_CONFIG)
    foreach(key api abi stl ndkRevision)
      string(JSON VISION_RUNTIME_${key} GET "${VISION_RUNTIME_CONFIG}" ${key})
      vision_require_receipt("${VISION_RUNTIME_${key}}" android ${key})
    endforeach()
    vision_require_receipt("ON" android pic)
  else()
    set(VISION_RUNTIME_api 28)
    set(VISION_RUNTIME_stl "c++_shared")
    string(CONCAT VISION_RUNTIME_abi "arm64" "-v8a")
  endif()
  if(NOT ANDROID_ABI STREQUAL VISION_RUNTIME_abi OR NOT VISION_ANDROID_API EQUAL VISION_RUNTIME_api
      OR NOT ANDROID_STL STREQUAL VISION_RUNTIME_stl OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
    message(FATAL_ERROR "Android Vision requires the prepared ABI, API, STL and NDK Clang")
  endif()
  file(STRINGS "${CMAKE_ANDROID_NDK}/source.properties" VISION_NDK_REVISION_LINE REGEX "^Pkg\\.Revision *=")
  string(REGEX REPLACE "^Pkg\\.Revision *= *([^ \r\n]+).*$" "\\1" VISION_NDK_REVISION "${VISION_NDK_REVISION_LINE}")
  vision_require_receipt("${VISION_NDK_REVISION}" android ndkRevision)
  vision_require_receipt("${ANDROID_ABI}" android abi)
  vision_require_receipt("${VISION_ANDROID_API}" android api)
  vision_require_receipt("${ANDROID_STL}" android stl)
  vision_require_receipt("${CMAKE_CXX_STANDARD}" android cxxStandard)
  vision_require_receipt("ON" android rtti)
  vision_require_receipt("ON" android exceptions)
  vision_require_receipt("none" android videoCaptureBackend)
  file(SHA256 "${VISION_PACKAGE_ROOT}/patches/opencv-mobile-android/INIT_MODULE_SOURCES_opencv_highgui.cmake" VISION_OPENCV_ANDROID_PATCH_HASH)
  vision_require_receipt("${VISION_OPENCV_ANDROID_PATCH_HASH}" patches opencvAndroidHighgui)
endif()
add_library(native_routes_vision_vendors INTERFACE)
target_include_directories(native_routes_vision_vendors INTERFACE
  "${VISION_VENDOR_PREFIX}/include/opencv4" "${VISION_VENDOR_PREFIX}/include/ncnn")
foreach(VISION_LIBRARY opencv_highgui opencv_imgproc opencv_core ncnn)
  if(ANDROID AND VISION_VENDOR_LINKAGE STREQUAL "shared")
    set(VISION_SHARED_LIBRARY "${VISION_VENDOR_PREFIX}/lib/lib${VISION_LIBRARY}.so")
    if(NOT EXISTS "${VISION_SHARED_LIBRARY}")
      message(FATAL_ERROR "Missing ${VISION_SHARED_LIBRARY}; prepare Android shared vendors first")
    endif()
    # Imported SHARED targets let AGP discover/package the vendor .so files.
    add_library(native_routes_vision::${VISION_LIBRARY} SHARED IMPORTED)
    set_target_properties(native_routes_vision::${VISION_LIBRARY} PROPERTIES IMPORTED_LOCATION "${VISION_SHARED_LIBRARY}")
    target_link_libraries(native_routes_vision_vendors INTERFACE native_routes_vision::${VISION_LIBRARY})
  else()
    set(VISION_STATIC_LIBRARY "${VISION_VENDOR_PREFIX}/lib/lib${VISION_LIBRARY}.a")
    if(NOT EXISTS "${VISION_STATIC_LIBRARY}")
      message(FATAL_ERROR "Missing ${VISION_STATIC_LIBRARY}; prepare static vendors first")
    endif()
    if(ANDROID)
      file(SHA256 "${VISION_STATIC_LIBRARY}" VISION_STATIC_LIBRARY_HASH)
      vision_require_receipt("${VISION_STATIC_LIBRARY_HASH}" artifacts "lib/lib${VISION_LIBRARY}.a")
    endif()
    target_link_libraries(native_routes_vision_vendors INTERFACE "${VISION_STATIC_LIBRARY}")
  endif()
endforeach()
if(ANDROID)
  if(VISION_VENDOR_LINKAGE STREQUAL "shared")
    set_property(TARGET native_routes_vision::opencv_highgui PROPERTY INTERFACE_LINK_LIBRARIES native_routes_vision::opencv_imgproc)
    set_property(TARGET native_routes_vision::opencv_imgproc PROPERTY INTERFACE_LINK_LIBRARIES native_routes_vision::opencv_core)
  endif()
  target_link_libraries(native_routes_vision_vendors INTERFACE m dl log)
endif()
