# App selection only. The legacy runtime CMake remains independently usable.
set(VALDI_HARMONY_RUNTIME_MODE "legacy" CACHE STRING "App runtime: legacy or fork (explicit opt-in)")
set_property(CACHE VALDI_HARMONY_RUNTIME_MODE PROPERTY STRINGS legacy fork)
set(VALDI_HARMONY_FORK_ROOT "" CACHE PATH "Explicit maintained fork root; contains valdi/harmony/runtime")
if(NOT VALDI_HARMONY_RUNTIME_MODE MATCHES "^(legacy|fork)$")
  message(FATAL_ERROR "VALDI_HARMONY_RUNTIME_MODE must be legacy or fork")
endif()
if(VALDI_HARMONY_RUNTIME_MODE STREQUAL "legacy")
  if(VALDI_HARMONY_FORK_ROOT OR VALDI_HARMONY_PROFILE)
    message(FATAL_ERROR "Fork root/profile requires explicit VALDI_HARMONY_RUNTIME_MODE=fork; refusing legacy fallback")
  endif()
  set(VALDI_HARMONY_APP_RUNTIME_TARGET valdi_runtime_ohos)
  set(VALDI_HARMONY_APP_FULL_DEVELOPMENT 0)
  set(_runtime_identity "legacy")
else()
  foreach(input FORK_ROOT PROFILE EXTERNAL_DIR PROTO_DIR WEBSOCKETPP_DIR)
    if(NOT DEFINED VALDI_HARMONY_${input} OR "${VALDI_HARMONY_${input}}" STREQUAL "")
      message(FATAL_ERROR "Fork app consumption requires explicit VALDI_HARMONY_${input}")
    endif()
  endforeach()
  if(NOT VALDI_HARMONY_PROFILE MATCHES "^(lean-release|full-development)$")
    message(FATAL_ERROR "VALDI_HARMONY_PROFILE must be lean-release or full-development")
  endif()
  foreach(input FORK_ROOT EXTERNAL_DIR PROTO_DIR WEBSOCKETPP_DIR)
    if(NOT IS_ABSOLUTE "${VALDI_HARMONY_${input}}" OR NOT IS_DIRECTORY "${VALDI_HARMONY_${input}}")
      message(FATAL_ERROR "VALDI_HARMONY_${input} must be an existing absolute directory")
    endif()
    file(REAL_PATH "${VALDI_HARMONY_${input}}" _resolved_${input})
  endforeach()
  if(DEFINED VALDI_HARMONY_SOURCE_DIR AND NOT VALDI_HARMONY_SOURCE_DIR STREQUAL "")
    file(REAL_PATH "${VALDI_HARMONY_SOURCE_DIR}" _requested_source)
    if(NOT _requested_source STREQUAL _resolved_FORK_ROOT)
      message(FATAL_ERROR "VALDI_HARMONY_SOURCE_DIR conflicts with VALDI_HARMONY_FORK_ROOT")
    endif()
  endif()
  set(VALDI_HARMONY_SOURCE_DIR "${_resolved_FORK_ROOT}" CACHE PATH "Selected maintained fork source" FORCE)
  set(_runtime_slice "${_resolved_FORK_ROOT}/valdi/harmony/runtime")
  if(NOT EXISTS "${_runtime_slice}/CMakeLists.txt")
    message(FATAL_ERROR "Fork root does not contain valdi/harmony/runtime/CMakeLists.txt")
  endif()
  find_program(VALDI_HARMONY_PROFILE_NODE NAMES node REQUIRED)
  set(_profile_checker "${VALDI_PROJECT_ROOT}/scripts/harmony/profile-config.mjs")
  execute_process(COMMAND "${VALDI_HARMONY_PROFILE_NODE}" "${_profile_checker}"
    --mode fork --fork-root "${VALDI_HARMONY_SOURCE_DIR}" --profile "${VALDI_HARMONY_PROFILE}"
    --external "${VALDI_HARMONY_EXTERNAL_DIR}" --proto "${VALDI_HARMONY_PROTO_DIR}"
    --websocketpp "${VALDI_HARMONY_WEBSOCKETPP_DIR}" --audit
    RESULT_VARIABLE _profile_result OUTPUT_VARIABLE _profile_output ERROR_VARIABLE _profile_error)
  if(NOT _profile_result EQUAL 0)
    message(FATAL_ERROR "Fork app prerequisites failed (no source modifications):\n${_profile_error}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_profile_checker}")
  # Rerun the read-only gate if a checked prerequisite changes.
  foreach(_file IN ITEMS
      Interfaces/IJavaScriptContext.hpp Interfaces/IJavaScriptContext.cpp
      JavaScript/JavaScriptValueDelegate.cpp JavaScript/JavaScriptUtils.cpp
      Views/GlobalViewFactories.cpp Context/ViewManagerContext.cpp Views/ViewPreloader.cpp Views/ViewPreloader.hpp
      JavaScript/JavaScriptRuntime.cpp Context/ViewNodeAssetHandler.cpp RuntimeManager.hpp RuntimeManager.cpp
      Debugger/DaemonClient.cpp)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
      "${VALDI_HARMONY_SOURCE_DIR}/valdi/src/valdi/runtime/${_file}")
  endforeach()
  set(VALDI_HARMONY_APP_RUNTIME_TARGET Valdi::HarmonyRuntime)
  set(VALDI_HARMONY_APP_FULL_DEVELOPMENT 0)
  if(VALDI_HARMONY_PROFILE STREQUAL "full-development")
    set(VALDI_HARMONY_APP_FULL_DEVELOPMENT 1)
  endif()
  set(_runtime_identity "fork|${_resolved_FORK_ROOT}|${VALDI_HARMONY_PROFILE}|${_resolved_EXTERNAL_DIR}|${_resolved_PROTO_DIR}|${_resolved_WEBSOCKETPP_DIR}|${OHOS_ARCH}")
endif()
# Never reuse objects when changing provider, source tree, profile or input roots.
if(DEFINED VALDI_HARMONY_APP_CONFIGURED_RUNTIME AND
    NOT VALDI_HARMONY_APP_CONFIGURED_RUNTIME STREQUAL _runtime_identity)
  message(FATAL_ERROR "App runtime inputs changed; use a fresh CMake build directory")
endif()
set(VALDI_HARMONY_APP_CONFIGURED_RUNTIME "${_runtime_identity}" CACHE INTERNAL "Frozen app runtime selection")
set(VALDI_HARMONY_LINK_CHECK OFF CACHE BOOL "" FORCE)
if(VALDI_HARMONY_RUNTIME_MODE STREQUAL "legacy")
  add_subdirectory("${VALDI_PROJECT_ROOT}/harmony/runtime-build" "${CMAKE_CURRENT_BINARY_DIR}/valdi-runtime")
else()
  add_subdirectory("${_runtime_slice}" "${CMAKE_CURRENT_BINARY_DIR}/valdi-runtime")
  if(NOT TARGET Valdi::HarmonyRuntime OR NOT TARGET valdi_runtime_ohos)
    message(FATAL_ERROR "Fork must export Valdi::HarmonyRuntime and the ClientSQL-compatible core target")
  endif()
endif()
message(STATUS "App Harmony runtime: ${_runtime_identity}")
