<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pages own their backgrounds. Only the system splash draws a shared launch background. -->
    <style name="Theme.ValdiNativeRoutes" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@null</item>
        <!-- Valdi and native components select their own dark palettes. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Theme.ValdiNativeRoutes.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/page_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.ValdiNativeRoutes</item>
    </style>
</resources>
