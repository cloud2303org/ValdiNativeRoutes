+TEST_F(ClientSQLDrizzleNativeTest, runRejectsInvalidStatementsWithoutSuccessMetadata) {
+    const std::vector<const char*> statements{
+        "INSERT INTO item(id) VALUES (1); INSERT INTO item(id) VALUES (2)",
+        "INSERT INTO missing_table(id) VALUES (1)",
+        "INSERT INTO item(id) VALUES (?)",
+    };
+    for (const auto* sql : statements) {
+        ClientSQLAsyncResult result;
+        callNativeFunction(connection, "run", {Value(sql), Value::undefined(), Value(result.makeCallback())});
+        result.waitForError();
+        EXPECT_EQ(1ul, result.callCount());
+    }
+    auto rows = queryRows(connection, STRING_LITERAL("SELECT COUNT(*) FROM item"));
+    ASSERT_NE(nullptr, rows);
+    ASSERT_EQ(1ul, rows->size());
+    auto row = (*rows)[0].getArrayRef();
+    ASSERT_NE(nullptr, row);
+    ASSERT_EQ(1ul, row->size());
+    EXPECT_EQ(0, (*row)[0].toInt());
+}
