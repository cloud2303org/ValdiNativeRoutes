load("//bzl/node_module:module.bzl", "node_valdi_module")

# The C++ implementation and factory live in cpp/ and link into the exported runtime.
# This target supplies the TypeScript bundle independently of that native implementation.
node_valdi_module(
    name = "app_vision",
    srcs = glob(["src/**/*.ts", "src/**/*.tsx"]),
    config = "module.json",
)
