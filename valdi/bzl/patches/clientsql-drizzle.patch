+Result<std::vector<Value>> sqliteRowToPositionalValues(sqlite3_stmt* statement) {
+    std::vector<Value> row;
+    const auto columnCount = sqlite3_column_count(statement);
+    row.reserve(static_cast<size_t>(columnCount));
