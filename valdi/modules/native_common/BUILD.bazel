load("//bzl/node_module:module.bzl", "node_valdi_module")

# Node owns TS and generated bindings. Host Gradle/Xcode owns android/ and ios/;
# the macro's standalone native targets are intentionally unused for this module.
node_valdi_module(
    name = "native_common",
    srcs = glob(["src/**/*.ts", "src/**/*.tsx"]),
    config = "module.json",
    ios_module_name = "NativeCommon",
    ios_language = "objc",
    deps = [
    ],
)
