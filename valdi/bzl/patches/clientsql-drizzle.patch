+// These cases exercise the actual typed native module and SQLite connections.
+class ClientSQLDrizzleNativeTest : public ::testing::Test {
+protected:
+    void SetUp() override {
+        diskCache = makeShared<DiskCacheImpl>(directory.get());
+        workerQueue = DispatchQueue::create(STRING_LITERAL("ClientSQL Drizzle Test Worker"), ThreadQoSClassNormal);
+        factory = makeShared<ClientSQLNativeModuleFactory>(diskCache, workerQueue);
+        module = factory->loadModule();
+        connection = openHandle();
+    }
+
+    void TearDown() override {
+        if (transactionDone != nullptr) {
+            finishTransaction(true);
+        }
+        for (const auto& handle : handles) {
+            ClientSQLAsyncResult closed;
+            callNativeFunction(handle, "close", {Value(closed.makeCallback())});
+            closed.waitForSuccess();
+        }
+        workerQueue->fullTeardown();
+    }
+
+    Value openHandle() {
+        auto handle = callNativeFunction(
+            module, "openDatabase", makeClientSQLOpenParameters(STRING_LITERAL("drizzle-native.sqlite")));
+        handles.emplace_back(handle);
+        return handle;
+    }
+
+    Value beginTransaction() {
+        ClientSQLAsyncResult ready;
+        auto body = makeShared<ValueFunctionWithCallable>(
+            [callback = ready.makeCallback()](const ValueFunctionCallContext& context) -> Value {
+                (*callback)({Value(ValueArray::make({context.getParameter(0), context.getParameter(1)})),
+                             Value::undefined()});
+                return Value::undefined();
+            });
+        callNativeFunction(connection, "transaction", {Value(body), Value(transactionResult.makeCallback())});
+        auto started = ready.waitForSuccess().getArrayRef();
+        if (started == nullptr || started->size() != 2) {
+            ADD_FAILURE() << "Native transaction did not supply its proxy and completion callback";
+            return Value::undefined();
+        }
+        transactionDone = (*started)[1].getFunctionRef();
+        EXPECT_NE(nullptr, transactionDone);
+        return (*started)[0];
+    }
+
+    void finishTransaction(bool rollback) {
+        ASSERT_NE(nullptr, transactionDone);
+        (*transactionDone)({Value::undefined(), rollback ? Value("drizzle rollback") : Value::undefined()});
+        transactionDone = nullptr;
+        if (rollback) {
+            EXPECT_NE(std::string::npos, transactionResult.waitForError().toString().find("drizzle rollback"));
+        } else {
+            transactionResult.waitForSuccess();
+        }
+    }
+
+    Value run(const Value& handle, StringBox sql, Value parameters = Value::undefined()) {
+        auto result = callClientSQLAsync(handle, "run", sql, std::move(parameters));
+        // ExportModel callback payloads can be represented by a typed object.
+        if (result.isTypedObject()) {
+            return Value(result.getTypedObjectRef()->toValueMap(true));
+        }
+        return result;
+    }
+
+    Ref<ValueArray> queryRows(const Value& handle, StringBox sql, Value parameters = Value::undefined()) {
+        return callClientSQLAsync(handle, "queryRows", sql, std::move(parameters)).getArrayRef();
+    }
+
+    ClientSQLTemporaryDirectory directory;
+    Ref<DiskCacheImpl> diskCache;
+    Ref<DispatchQueue> workerQueue;
+    Ref<ClientSQLNativeModuleFactory> factory;
+    Value module;
+    Value connection;
+    std::vector<Value> handles;
+    ClientSQLAsyncResult transactionResult;
+    Ref<ValueFunction> transactionDone;
+};
