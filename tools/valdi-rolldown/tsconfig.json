{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts", "**/*.mts", "modules.mjs", "typecheck-node.mjs"],
  "exclude": ["node_modules", ".gen", "**/*.test.ts", "**/*.test.mts"]
}
