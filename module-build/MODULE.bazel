module(name = "node_valdi_modules", version = "0.1")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_apple", version = "4.0.0")
bazel_dep(name = "apple_support", version = "1.22.1")
single_version_override(module_name = "rules_apple", version = "4.0.0")

# -- Maintained Valdi fork (upstream base: beta-0.2.1) -----------------------
# Framework customizations and Hermes build inputs live in this fork's valdiroutes branch.
# Pin immutable commits; scripts/upstream.mjs updates this and the matching registry together.
VALDI_REPOSITORY = "cloud2303org/Valdi"
VALDI_COMMIT = "67e02521ce5bcf88aa0690e300a3135cb84379a4"
VALDI_URL = "https://github.com/" + VALDI_REPOSITORY + "/archive/" + VALDI_COMMIT + ".tar.gz"
VALDI_PREFIX = "Valdi-" + VALDI_COMMIT

bazel_dep(name = "valdi", version = "0.1")
archive_override(
    module_name = "valdi",
    urls = [VALDI_URL],
    strip_prefix = VALDI_PREFIX,
)

# Valdi internal sub-modules: local_path_override in Valdi's own MODULE.bazel
# only takes effect when Valdi is the root module. Consumers must provide
# archive_override entries that point into the Valdi release archive.
bazel_dep(name = "android_macros")
archive_override(module_name = "android_macros", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/bzl/macros")

bazel_dep(name = "snap_macros")
archive_override(module_name = "snap_macros", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/bzl/valdi/snap_macros")

bazel_dep(name = "snap_client_toolchains")
archive_override(module_name = "snap_client_toolchains", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/bzl/toolchains")

bazel_dep(name = "snap_platforms")
archive_override(module_name = "snap_platforms", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/bzl/platforms")

bazel_dep(name = "skia_user_config")
archive_override(module_name = "skia_user_config", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/third-party/skia_user_config")

bazel_dep(name = "rules_hdrs")
archive_override(module_name = "rules_hdrs", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/third-party/rules_hdrs")

bazel_dep(name = "valdi_toolchain")
archive_override(module_name = "valdi_toolchain", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/bin")

# -- C++ toolchains (Apple CC before LLVM for ObjC priority) ------------------
valdi_toolchains = use_extension("@valdi//bzl:valdi_toolchains.bzl", "valdi_toolchains")
use_repo(valdi_toolchains, "local_config_apple_cc_toolchains", "local_config_apple_cc", "llvm_toolchain", "llvm_toolchain_llvm")
register_toolchains("@local_config_apple_cc_toolchains//:all")
register_toolchains("@llvm_toolchain//:all")

# -- Android dependencies ----------------------------------------------------
bazel_dep(name = "rules_java", version = "8.14.0")
bazel_dep(name = "rules_android", version = "0.6.5")
# Resolve rules_android from the Valdi registry, which carries the hermetic Android SDK
# patch (registry/modules/rules_android/0.6.5) so bootstrapped apps build Android targets
# with no local ANDROID_HOME.
single_version_override(module_name = "rules_android", version = "0.6.5")
bazel_dep(name = "rules_android_ndk", version = "0.1.3")

remote_android_extensions = use_extension(
    "@rules_android//bzlmod_extensions:android_extensions.bzl",
    "remote_android_tools_extensions",
)
use_repo(remote_android_extensions, "android_gmaven_r8", "android_tools")

hermetic_android_sdk_extension = use_extension("@valdi//bzl:hermetic_android_sdk.bzl", "hermetic_android_sdk_extension")
hermetic_android_sdk_extension.configure(
    api_level = 36,
    build_tools_version = "34.0.0",
)
use_repo(hermetic_android_sdk_extension, "androidsdk")

register_toolchains(
    "@rules_android//toolchains/android:all",
    "@rules_android//toolchains/android_sdk:all",
)
register_toolchains("@androidsdk//:sdk-toolchain", "@androidsdk//:all")

hermetic_ndk_extension = use_extension("@valdi//bzl:hermetic_ndk.bzl", "hermetic_ndk_extension")
use_repo(hermetic_ndk_extension, "androidndk")

register_toolchains("@androidndk//:all")

# Same rules_kotlin as Valdi itself (its registry carries the 2.3.10 patch); 1.9.0 compiled with Kotlin 1.9.
bazel_dep(name = "rules_kotlin", version = "2.3.10")
single_version_override(module_name = "rules_kotlin", version = "2.3.10")
bazel_dep(name = "rules_jvm_external", version = "6.6")

# Root install tags select the direct Google artifact endpoint for all native
# Android namespaces. Artifact/version declarations remain in Valdi and rules_android.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
MAVEN_REPOSITORIES = [
    "https://repo1.maven.org/maven2",
    "https://dl.google.com/dl/android/maven2",
]
maven.install(
    name = "android_mvn",
    repositories = MAVEN_REPOSITORIES,
)
maven.install(
    name = "android_ide_common_30_1_3",
    repositories = MAVEN_REPOSITORIES,
)
maven.install(
    name = "rules_android_maven",
    repositories = MAVEN_REPOSITORIES,
)
use_repo(maven, "android_mvn", "android_ide_common_30_1_3", "rules_android_maven")

node_valdi_environment = use_repo_rule("//bzl/node_module:repositories.bzl", "node_valdi_environment")
node_valdi_environment(name = "node_valdi_local", project = "//:MODULE.bazel")
