# The app's C++, linked into the Valdi runtime by //:valdi_runtime (native_deps; bzl/patches/valdi/
# export_native_deps.patch): the implementations of app_pages' @ExportModule modules (src/) and the C++ bindings they
# implement (generated/, written by tools/valdi-rolldown/codegen.ts --cpp-out, regenerated by hand when the TypeScript
# changes). Compiled with the runtime, so it shares its C++ library; a change here needs a new export.
cc_library(
    name = "app_pages_native",
    srcs = glob([
        "generated/**/*.cpp",
        "src/**/*.cpp",
    ]),
    hdrs = glob(["generated/**/*.hpp"]),
    # Each module registers its factory from a static initializer, which nothing else references.
    alwayslink = True,
    strip_include_prefix = "generated",
    visibility = ["//visibility:public"],
    deps = ["@valdi//valdi_core:valdi_core_cc"],
)
