+TEST_F(ClientSQLDrizzleNativeTest, defersOutsideQueryRowsAndRunUntilTransactionRollsBack) {
+    auto outside = openHandle();
+    auto transaction = beginTransaction();
+    ASSERT_FALSE(transaction.isNullOrUndefined());
+    run(transaction, STRING_LITERAL("INSERT INTO item(id) VALUES (1)"));
+
+    ClientSQLAsyncResult outsideRows;
+    ClientSQLAsyncResult outsideRun;
+    callNativeFunction(outside, "queryRows",
+                       {Value("INSERT INTO item(id) VALUES (2) RETURNING id"), Value::undefined(),
+                        Value(outsideRows.makeCallback())});
+    callNativeFunction(outside, "run",
+                       {Value("INSERT INTO item(id) VALUES (3)"), Value::undefined(), Value(outsideRun.makeCallback())});
+    // debugInfo runs on the writer and is an ordering barrier, avoiding timing guesses.
+    ClientSQLAsyncResult debug;
+    callNativeFunction(connection, "debugInfo", {Value(debug.makeCallback())});
+    auto info = debug.waitForSuccess();
+    EXPECT_TRUE(info.getMapValue("activeTransaction").toBool());
+    EXPECT_EQ(2, info.getMapValue("deferredWriterWork").toInt());
+    EXPECT_FALSE(outsideRows.wasCalled());
+    EXPECT_FALSE(outsideRun.wasCalled());
+
+    finishTransaction(true);
+    auto returned = outsideRows.waitForSuccess().getArrayRef();
+    ASSERT_NE(nullptr, returned);
+    ASSERT_EQ(1ul, returned->size());
+    auto returnedRow = (*returned)[0].getArrayRef();
+    ASSERT_NE(nullptr, returnedRow);
+    ASSERT_EQ(1ul, returnedRow->size());
+    EXPECT_EQ(2, (*returnedRow)[0].toInt());
+    auto metadata = outsideRun.waitForSuccess();
+    if (metadata.isTypedObject()) {
+        metadata = Value(metadata.getTypedObjectRef()->toValueMap(true));
+    }
+    EXPECT_EQ(1, metadata.getMapValue("changes").toInt());
+    EXPECT_EQ(STRING_LITERAL("3"), metadata.getMapValue("lastInsertRowid").toStringBox());
+    auto persisted = queryRows(connection, STRING_LITERAL("SELECT id FROM item ORDER BY id"));
+    ASSERT_NE(nullptr, persisted);
+    ASSERT_EQ(2ul, persisted->size());
+    for (size_t index = 0; index < persisted->size(); ++index) {
+        auto row = (*persisted)[index].getArrayRef();
+        ASSERT_NE(nullptr, row);
+        ASSERT_EQ(1ul, row->size());
+        EXPECT_EQ(static_cast<int>(index + 2), (*row)[0].toInt());
+    }
+}
