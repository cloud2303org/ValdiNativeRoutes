+TEST_F(ClientSQLDrizzleNativeTest, queryRowsPreservesDuplicateAliasesAndSQLiteConversions) {
+    auto bytes = makeShared<Bytes>();
+    const Byte payload[] = {0x00, 0x7f, 0xff};
+    bytes->assignData(payload, sizeof(payload));
+    auto blob = Value(makeShared<ValueTypedArray>(TypedArrayType::ArrayBuffer, bytes));
+    auto rows = queryRows(
+        connection,
+        STRING_LITERAL("SELECT 7 AS duplicate, 9 AS duplicate, ? AS payload, NULL, '', X'', 1.25, ?"),
+        Value(ValueArray::make({blob, Value(true)})));
+    ASSERT_NE(nullptr, rows);
+    ASSERT_EQ(1ul, rows->size());
+    auto row = (*rows)[0].getArrayRef();
+    ASSERT_NE(nullptr, row);
+    ASSERT_EQ(8ul, row->size());
+    EXPECT_EQ(7, (*row)[0].toInt());
+    EXPECT_EQ(9, (*row)[1].toInt());
+    ASSERT_EQ(ValueType::TypedArray, (*row)[2].getType());
+    auto buffer = (*row)[2].getTypedArray()->getBuffer();
+    ASSERT_EQ(sizeof(payload), buffer.size());
+    EXPECT_EQ(0, std::memcmp(payload, buffer.data(), sizeof(payload)));
+    EXPECT_EQ(ValueType::Null, (*row)[3].getType());
+    EXPECT_EQ(STRING_LITERAL(""), (*row)[4].toStringBox());
+    ASSERT_EQ(ValueType::TypedArray, (*row)[5].getType());
+    EXPECT_EQ(0ul, (*row)[5].getTypedArray()->getBuffer().size());
+    EXPECT_EQ(1.25, (*row)[6].toDouble());
+    EXPECT_EQ(1, (*row)[7].toInt());
+
+    // Legacy query still maps columns by name, including its last-alias-wins behavior.
+    auto legacy = queryClientSQL(connection, "query", STRING_LITERAL("SELECT 7 AS duplicate, 9 AS duplicate"),
+                                 Value::undefined()).getArrayRef();
+    ASSERT_NE(nullptr, legacy);
+    ASSERT_EQ(1ul, legacy->size());
+    EXPECT_EQ(9, (*legacy)[0].getMapValue("duplicate").toInt());
+}
