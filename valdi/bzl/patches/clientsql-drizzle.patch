+TEST_F(ClientSQLDrizzleNativeTest, rejectsParentAndClosedHandleCallsForNewMethods) {
+    auto transaction = beginTransaction();
+    ASSERT_FALSE(transaction.isNullOrUndefined());
+    for (const auto* method : {"queryRows", "run"}) {
+        ClientSQLAsyncResult rejected;
+        callNativeFunction(connection, method,
+                           {Value("SELECT 1"), Value::undefined(), Value(rejected.makeCallback())});
+        EXPECT_NE(std::string::npos, rejected.waitForError().toString().find("not allowed inside its transaction body"));
+    }
+    run(transaction, STRING_LITERAL("INSERT INTO item(id) VALUES (1)"));
+    finishTransaction(false);
+    auto rows = queryRows(connection, STRING_LITERAL("SELECT id FROM item"));
+    ASSERT_NE(nullptr, rows);
+    ASSERT_EQ(1ul, rows->size());
+    ClientSQLAsyncResult closed;
+    callNativeFunction(connection, "close", {Value(closed.makeCallback())});
+    closed.waitForSuccess();
+    for (const auto* method : {"queryRows", "run"}) {
+        ClientSQLAsyncResult rejected;
+        callNativeFunction(connection, method,
+                           {Value("SELECT 1"), Value::undefined(), Value(rejected.makeCallback())});
+        EXPECT_NE(std::string::npos, rejected.waitForError().toString().find("connection is closed"));
+    }
 }
 
