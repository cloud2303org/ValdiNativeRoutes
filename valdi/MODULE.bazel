# -- Version pins (must match Valdi's MODULE.bazel) ---------------------------
single_version_override(module_name = "protobuf", version = "29.3")
single_version_override(module_name = "rules_apple", version = "4.0.0")
single_version_override(module_name = "rules_pkg", version = "0.9.1")
single_version_override(module_name = "zlib", version = "1.3.2")

# rules_python 1.9.0's hermetic Python toolchain bundles setuptools files whose
# names contain spaces (e.g. "Lorem ipsum.txt"), which Bazel's build-runfiles
# cannot materialize on macOS. The patch renames them. It is vendored into this
# app (bzl/patches/...) and referenced with a root-local `//` label on purpose:
# bzlmod only applies this override from the ROOT module, and `@valdi` resolves
# to the pinned public release, which may not ship the patch. See the CLI
# README ("Bootstrap pins and patches").
bazel_dep(name = "rules_python", version = "1.9.0")
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.single_version_platform_override(
    patch_strip = 1,
    patches = ["//bzl/patches/rules_python/1.9.0:remove_setuptools_spaces.patch"],
    platform = "aarch64-apple-darwin",
    python_version = "3.11.14",
)

# -- Rust toolchain ------------------------------------------------------------
# rules_rust only honors rust.toolchain() from the root module, so Valdi's own
# toolchain config does not reach bootstrapped apps. Mirror it here.
# -Cstrip=none for exec-config (host tool / proc-macro) builds: rustc's
# debuginfo strip leaves a misaligned LINKEDIT string table that macOS 27 dyld
# rejects when the dylib was linked against SDK 27 (rust-lang/rust#157750,
# fixed in Rust 1.98.0).
bazel_dep(name = "rules_rust", version = "0.64.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_exec_rustc_flags = ["-Cstrip=none"],
    extra_target_triples = [
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
        "aarch64-linux-android",
        "armv7-linux-androideabi",
        "x86_64-apple-ios",
        "x86_64-linux-android",
    ],
    versions = ["1.87.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")
