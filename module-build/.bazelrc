try-import %workspace%/win.local.bazelrc

common --registry=https://raw.githubusercontent.com/cloud2303org/Valdi/02dbebc2969c32607de6aaeac888d28435ec669c/registry
common --registry=https://bcr.bazel.build
common --enable_platform_specific_config
common --noincompatible_disallow_empty_glob
common --incompatible_disallow_struct_provider_syntax=false
build:macos --spawn_strategy=local
build --tool_java_language_version=17
build --java_language_version=11
build --java_runtime_version=11
build --tool_java_runtime_version=17
common --experimental_google_legacy_api=true
common --experimental_enable_android_migration_apis=true
common --incompatible_java_common_parameters=false
build --ios_minimum_os=16.0
build --disk_cache=~/.cache/bazel-disk-cache

# The Windows entry points (scripts/windows/lib.ps1) write win.cache.bazelrc to redirect shared caches for an
# isolated build. Imported last so its options win over the defaults above.
try-import %workspace%/win.cache.bazelrc
