{
  "nativeBuild": "host",
  "iosLanguage": "objc",
  "androidClassPath": "io.valdiroutes.wifi",
  "androidModuleFactory": "io.valdiroutes.wifi.WifiModuleFactoryImpl",
  "androidModuleFactoryContext": true,
  "iosModuleFactoryClass": "VRWifiModuleFactory",
  "iosModuleName": "Wifi",
  "androidDependencies": [
    "androidx.core:core-ktx:1.17.0"
  ],
  "androidFeatures": [
    {
      "name": "android.hardware.wifi",
      "required": false
    }
  ],
  "androidPermissions": [
    {
      "name": "android.permission.ACCESS_WIFI_STATE"
    },
    {
      "name": "android.permission.CHANGE_WIFI_STATE"
    },
    {
      "name": "android.permission.ACCESS_NETWORK_STATE"
    },
    {
      "name": "android.permission.CHANGE_NETWORK_STATE"
    },
    {
      "name": "android.permission.NEARBY_WIFI_DEVICES",
      "usesPermissionFlags": "neverForLocation"
    },
    {
      "name": "android.permission.ACCESS_FINE_LOCATION",
      "removeMaxSdkVersion": true
    },
    {
      "name": "android.permission.ACCESS_COARSE_LOCATION",
      "removeMaxSdkVersion": true
    }
  ],
  "iosInfoPlist": {
    "NSLocationWhenInUseUsageDescription": "读取当前 Wi-Fi 名称，或以 iBeacon 方式广播时使用定位服务"
  },
  "iosEntitlements": {
    "com.apple.developer.networking.HotspotConfiguration": true,
    "com.apple.developer.networking.wifi-info": true
  },
  "iosFrameworks": [
    "CoreLocation",
    "Network",
    "NetworkExtension",
    "UIKit"
  ]
}
