index c5531464c2eb48745ce48003f2b1a6d86353d21e..0202351ff0da688850b6595b173806605f384264 100644
--- a/.metadata/.bazelrc.template
+++ b/.metadata/.bazelrc.template
@@ -4,6 +4,11 @@ common --registry=https://bcr.bazel.build
 
 common --enable_platform_specific_config
 
+# Bazel 8, as Valdi's own .bazelrc: some Valdi BUILD files glob for files that don't exist on every host, and some
+# rules still return legacy struct providers.
+common --noincompatible_disallow_empty_glob
+common --incompatible_disallow_struct_provider_syntax=false
+
 # Disable workers for repo fetching to prevent OOM
 common --experimental_worker_for_repo_fetching=off
 
