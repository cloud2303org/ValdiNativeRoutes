+TEST_F(ClientSQLDrizzleNativeTest, transactionQueryRowsAndRunRespectSavepointsAndRollback) {
+    auto transaction = beginTransaction();
+    ASSERT_FALSE(transaction.isNullOrUndefined());
+    auto inserted = run(transaction, STRING_LITERAL("INSERT INTO item(id) VALUES (11)"));
+    EXPECT_EQ(1, inserted.getMapValue("changes").toInt());
+    EXPECT_EQ(STRING_LITERAL("11"), inserted.getMapValue("lastInsertRowid").toStringBox());
+    executeClientSQL(transaction, STRING_LITERAL("SAVEPOINT drizzle_nested"), Value::undefined());
+    auto returned = queryRows(transaction, STRING_LITERAL("INSERT INTO item(id) VALUES (12) RETURNING id, id"));
+    ASSERT_NE(nullptr, returned);
+    ASSERT_EQ(1ul, returned->size());
+    auto returnedRow = (*returned)[0].getArrayRef();
+    ASSERT_NE(nullptr, returnedRow);
+    ASSERT_EQ(2ul, returnedRow->size());
+    EXPECT_EQ(12, (*returnedRow)[0].toInt());
+    EXPECT_EQ(12, (*returnedRow)[1].toInt());
+    executeClientSQL(transaction, STRING_LITERAL("ROLLBACK TO SAVEPOINT drizzle_nested"), Value::undefined());
+    executeClientSQL(transaction, STRING_LITERAL("RELEASE SAVEPOINT drizzle_nested"), Value::undefined());
+    auto visible = queryRows(transaction, STRING_LITERAL("SELECT id, NULL, X'00ff' FROM item"));
+    ASSERT_NE(nullptr, visible);
+    ASSERT_EQ(1ul, visible->size());
+    auto row = (*visible)[0].getArrayRef();
+    ASSERT_NE(nullptr, row);
+    ASSERT_EQ(3ul, row->size());
+    EXPECT_EQ(11, (*row)[0].toInt());
+    EXPECT_EQ(ValueType::Null, (*row)[1].getType());
+    ASSERT_EQ(ValueType::TypedArray, (*row)[2].getType());
+    const Byte payload[] = {0x00, 0xff};
+    auto buffer = (*row)[2].getTypedArray()->getBuffer();
+    ASSERT_EQ(sizeof(payload), buffer.size());
+    EXPECT_EQ(0, std::memcmp(payload, buffer.data(), sizeof(payload)));
+    finishTransaction(true);
+    auto after = queryRows(connection, STRING_LITERAL("SELECT id FROM item"));
+    ASSERT_NE(nullptr, after);
+    EXPECT_EQ(0ul, after->size());
+    for (const auto* method : {"queryRows", "run"}) {
+        ClientSQLAsyncResult stale;
+        callNativeFunction(transaction, method,
+                           {Value("INSERT INTO item(id) VALUES (13)"), Value::undefined(), Value(stale.makeCallback())});
+        EXPECT_NE(std::string::npos, stale.waitForError().toString().find("transaction is no longer active"));
+    }
+}
