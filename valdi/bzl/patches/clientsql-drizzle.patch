+        callNativeFunction(connection, "queryRows",
+                           {Value(test.first), Value::undefined(), Value(result.makeCallback())});
+        const auto error = result.waitForError().toString();
+        EXPECT_NE(std::string::npos, error.find(test.second)) << error;
+        EXPECT_EQ(1ul, result.callCount());
+    }
+    std::string nullColumns =
+        "WITH RECURSIVE n(v) AS (VALUES(1) UNION ALL SELECT v+1 FROM n WHERE v<300) SELECT NULL";
+    for (size_t index = 1; index < 512; ++index) {
+        nullColumns.append(", NULL");
+    }
+    nullColumns.append(" FROM n");
+    ClientSQLAsyncResult result;
+    callNativeFunction(connection, "queryRows",
+                       {Value(StringCache::getGlobal().makeString(nullColumns)), Value::undefined(),
+                        Value(result.makeCallback())});
+    EXPECT_NE(std::string::npos, result.waitForError().toString().find("8388608 byte materialization limit"));
+}
