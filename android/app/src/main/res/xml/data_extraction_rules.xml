<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the token (TokenStoreImpl) is encrypted with a Keystore key that never leaves this device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>
