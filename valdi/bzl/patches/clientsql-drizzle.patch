+TEST_F(ClientSQLDrizzleNativeTest, runCapturesSameConnectionMetadataAndExactSignedRowids) {
+    auto second = openHandle();
+    // Both requests are queued before either result is consumed. Each result must be a snapshot.
+    ClientSQLAsyncResult firstResult;
+    ClientSQLAsyncResult secondResult;
+    callNativeFunction(connection, "run",
+                       {Value("INSERT INTO item(id) VALUES (9223372036854775807)"), Value::undefined(),
+                        Value(firstResult.makeCallback())});
+    callNativeFunction(second, "run",
+                       {Value("INSERT INTO item(id) VALUES (-9223372036854775808)"), Value::undefined(),
+                        Value(secondResult.makeCallback())});
+    auto first = firstResult.waitForSuccess();
+    auto next = secondResult.waitForSuccess();
+    if (first.isTypedObject()) {
+        first = Value(first.getTypedObjectRef()->toValueMap(true));
+    }
+    if (next.isTypedObject()) {
+        next = Value(next.getTypedObjectRef()->toValueMap(true));
+    }
+    EXPECT_EQ(1, first.getMapValue("changes").toInt());
+    EXPECT_EQ(STRING_LITERAL("9223372036854775807"), first.getMapValue("lastInsertRowid").toStringBox());
+    EXPECT_EQ(1, next.getMapValue("changes").toInt());
+    EXPECT_EQ(STRING_LITERAL("-9223372036854775808"), next.getMapValue("lastInsertRowid").toStringBox());
+    EXPECT_EQ(1ul, firstResult.callCount());
+    EXPECT_EQ(1ul, secondResult.callCount());
+
+    auto updated = run(connection, STRING_LITERAL("UPDATE item SET id = id"));
+    EXPECT_EQ(2, updated.getMapValue("changes").toInt());
+    EXPECT_EQ(STRING_LITERAL("-9223372036854775808"), updated.getMapValue("lastInsertRowid").toStringBox());
+    auto unchanged = run(connection, STRING_LITERAL("DELETE FROM item WHERE id = 0"));
+    EXPECT_EQ(0, unchanged.getMapValue("changes").toInt());
+    auto returning = run(connection, STRING_LITERAL("INSERT INTO item(id) VALUES (?) RETURNING id"),
+                         Value(ValueArray::make({Value(5)})));
+    EXPECT_EQ(1, returning.getMapValue("changes").toInt());
+    EXPECT_EQ(STRING_LITERAL("5"), returning.getMapValue("lastInsertRowid").toStringBox());
+}
