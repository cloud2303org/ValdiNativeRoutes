# tools/valdi-rolldown/codegen.ts writes these bindings with LF and its --check
# byte-compares them against the checked-in files, which the export scripts run
# on every platform. A Windows checkout with core.autocrlf=true would otherwise
# rewrite them to CRLF and fail the check.
valdi/native/generated/** text eol=lf
android/app/generated/valdi/** text eol=lf
ios/Generated/valdi/** text eol=lf
