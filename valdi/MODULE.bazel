module(name = "valdi_native_routes", version = "0.1")

# BUILD.bazel selects on @platforms//os; Bazel 8 no longer makes it visible to the root module without a dep. Same
# version as Valdi.
bazel_dep(name = "platforms", version = "1.1.0")

# -- Valdi framework (https://github.com/Snapchat/Valdi) ---------------------
VALDI_TAG = "beta-0.2.1"
VALDI_URL = "https://github.com/Snapchat/Valdi/archive/" + VALDI_TAG + ".tar.gz"
VALDI_PREFIX = "Valdi-" + VALDI_TAG

bazel_dep(name = "valdi", version = "0.1")
archive_override(
    module_name = "valdi",
    urls = [VALDI_URL],
    strip_prefix = VALDI_PREFIX,
    # ClientSQL's py_binary used Bazel's native rule, which rules_python 1.9 launches without import paths
    # ("No module named 'python'"), breaking .sq compilation and the hot reloader. Load the rules_python ones.
    patches = [
        "//bzl/patches/valdi:clientsql_rules_python.patch",
        # Hermes V1 (260318099.0.4) instead of the 2024 Hermes Valdi pins; build file in //third_party/hermes_v1.
        "//bzl/patches/valdi:hermes_v1.patch",
        # Valdi's Hermes adapter ported to the Hermes V1 VM API.
        "//bzl/patches/valdi:hermes_v1_adapter.patch",
        # With modules precompiled to Hermes bytecode: Hermes in every flavor, no QuickJS, no JavaScriptCore.
        "//bzl/patches/valdi:hermes_release.patch",
        # terser 4.6 (Valdi's release minifier) can't parse ?. and ??; use the terser 5.44.1 already in the lockfile.
        "//bzl/patches/valdi:terser5.patch",
        # Hermes V1 runs async/await, ?., ?? and object spread natively (ES2016 output lowered them to helpers), and has
        # the ES2021 library (replaceAll, Promise.allSettled).
        "//bzl/patches/valdi:ts_target_es2020.patch",
        # 16 KB-aligned libvaldi_runtime.so; lld's default is 4 KB on arm64/armv7.
        "//bzl/patches/valdi:android_16kb_pages.patch",
        # The exported xcframework misses the drawing module headers its own SCValdiDrawingModuleFactory.h imports.
        "//bzl/patches/valdi:ios_export_drawing_hdrs.patch",
        # Precompile Hermes bytecode for iOS release too; Valdi only does it for Android, and lean Hermes can't run source.
        "//bzl/patches/valdi:ios_hermes_bytecode.patch",
        # The custom module provider also resolves module images, so an over-the-air package carries its own images.
        "//bzl/patches/valdi:custom_module_assets.patch",
        # valdi_exported_library(native_deps): the app's C++ (@ExportModule implementations) linked into the runtime.
        "//bzl/patches/valdi:export_native_deps.patch",
    ],
    patch_strip = 1,
)

# Valdi internal sub-modules: local_path_override in Valdi's own MODULE.bazel
# only takes effect when Valdi is the root module. Consumers must provide
# archive_override entries that point into the Valdi release archive.
bazel_dep(name = "android_macros")
archive_override(module_name = "android_macros", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/bzl/macros")

bazel_dep(name = "snap_macros")
archive_override(module_name = "snap_macros", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/bzl/valdi/snap_macros")

bazel_dep(name = "snap_client_toolchains")
archive_override(module_name = "snap_client_toolchains", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/bzl/toolchains")

bazel_dep(name = "snap_platforms")
archive_override(module_name = "snap_platforms", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/bzl/platforms")

bazel_dep(name = "skia_user_config")
archive_override(module_name = "skia_user_config", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/third-party/skia_user_config")

bazel_dep(name = "rules_hdrs")
archive_override(module_name = "rules_hdrs", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/third-party/rules_hdrs")

bazel_dep(name = "valdi_toolchain")
archive_override(module_name = "valdi_toolchain", urls = [VALDI_URL], strip_prefix = VALDI_PREFIX + "/bin")

# -- Valdi Widgets (https://github.com/Snapchat/Valdi_Widgets) ---------------
WIDGETS_TAG = "beta-0.2.1"

bazel_dep(name = "valdi_widgets")
archive_override(
    module_name = "valdi_widgets",
    urls = ["https://github.com/Snapchat/Valdi_Widgets/archive/" + WIDGETS_TAG + ".tar.gz"],
    strip_prefix = "Valdi_Widgets-" + WIDGETS_TAG,
