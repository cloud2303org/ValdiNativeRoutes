{
  "private": true,
  "version": "0.1.2",
  "packageManager": "pnpm@10.32.1",
  "valdi": {
    "app": {
      "name": "ValdiRoutes",
      "displayName": "Valdi 路由",
      "icon": "assets/app-icon.png",
      "android": {
        "applicationId": "io.valdiroutes.app"
      },
      "ios": {
        "bundleIdentifier": "io.valdiroutes.app"
      },
      "native": {
        "androidNamespace": "io.valdiroutes.app",
        "iosPrefix": "VR"
      }
    },
    "ota": {
      "bundleVersion": "pages-001"
    },
    "modules": [
      "app_foundation",
      "app_ota",
      "app_pages",
      "app_ui",
      "app_video",
      "app_vision",
      "bluetooth",
      "calculator",
      "mmkv",
      "native_common",
      "nfc",
      "permissions",
      "theme_bridge",
      "valdi_webview",
      "wifi"
    ]
  },
  "scripts": {
    "postinstall": "node scripts/install.mjs",
    "android": "node scripts/cli.mjs android",
    "ios": "node scripts/cli.mjs ios",
    "dev": "node scripts/cli.mjs dev",
    "build": "node scripts/project.mjs modules",
    "build:web": "node tools/valdi-rolldown/node_modules/tsx/dist/cli.mjs tools/valdi-rolldown/web/build.ts",
    "db:generate": "node scripts/database.mjs generate",
    "db:check": "node scripts/database.mjs check",
    "db:test:native": "node scripts/database.mjs test-native",
    "build:android": "node scripts/project.mjs android",
    "build:ios": "node scripts/project.mjs ios",
    "test": "node scripts/project.mjs test",
    "ota:tool": "node scripts/hdiff-tool.mjs",
    "release:pack": "node scripts/release.mjs",
    "new-module": "node tools/valdi-rolldown/node_modules/tsx/dist/cli.mjs tools/valdi-rolldown/new-module.ts",
    "tsconfig": "node tools/valdi-rolldown/node_modules/tsx/dist/cli.mjs tools/valdi-rolldown/tsconfig.ts",
    "test:e2e:android": "sh scripts/e2e.sh android",
    "test:e2e:ios": "sh scripts/e2e.sh ios",
    "check": "biome check valdi/modules",
    "format": "biome format --write valdi/modules"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "yaml": "2.9.1"
  }
}
